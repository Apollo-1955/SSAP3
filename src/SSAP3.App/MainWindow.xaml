<Window x:Class="SSAP3.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSAP3"
        Width="430"
        Height="704"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F21A1D27" Offset="0" />
            <GradientStop Color="#F5151720" Offset="0.52" />
            <GradientStop Color="#F410121A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#554C86FF" Offset="0" />
            <GradientStop Color="#3A8C63DF" Offset="0.48" />
            <GradientStop Color="#3046C7B4" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="PopupRoot"
          RenderTransformOrigin="0.95,0.98"
          Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopupScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="PopupTranslate" Y="18" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border Margin="13"
                CornerRadius="30"
                Background="#80000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="10"
                                  Opacity="0.52"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Margin="8"
                Background="{StaticResource WindowSurface}"
                BorderBrush="#3DFFFFFF"
                BorderThickness="1"
                CornerRadius="28"
                MouseLeftButtonDown="WindowSurface_OnMouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Ellipse Width="360"
                         Height="280"
                         Margin="-170,-160,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Fill="#264E84FF">
                    <Ellipse.Effect>
                        <BlurEffect Radius="55" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="320"
                         Height="260"
                         Margin="0,280,-210,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="#1B4FD5B9">
                    <Ellipse.Effect>
                        <BlurEffect Radius="65" />
                    </Ellipse.Effect>
                </Ellipse>

                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="20,16,20,20">
                        <Grid Margin="3,0,3,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="28"
                                       Height="28"
                                       Source="/Assets/ssap3-mark.png"
                                       Stretch="Uniform" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock Text="SSAP3"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="AirPods control center"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button x:Name="RefreshButton"
                                        Style="{StaticResource CircleButtonStyle}"
                                        Content="↻"
                                        FontSize="16"
                                        Click="RefreshButton_OnClick"
                                        Margin="0,0,7,0"
                                        ToolTip="Refresh" />
                                <Button Style="{StaticResource CircleButtonStyle}"
                                        Content="×"
                                        FontSize="18"
                                        Click="HideButton_OnClick"
                                        ToolTip="Hide to tray" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource HeroSurface}"
                                BorderBrush="#32FFFFFF"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="18,16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DeviceModel"
                                                   Text="AirPods 4 (ANC)"
                                                   FontSize="21"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <Ellipse x:Name="ConnectionDot"
                                                     Width="7"
                                                     Height="7"
                                                     Fill="#64E6A2"
                                                     Margin="0,0,6,0" />
                                            <TextBlock x:Name="ConnectionBadge"
                                                       Text="Connected · Stereo"
                                                       Foreground="#DDE8F7"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="⌁"
                                               FontSize="29"
                                               Foreground="#DFFFFFFF"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,17,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1AFFFFFF"
                                            CornerRadius="12"
                                            Padding="10,7"
                                            Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Left"
                                                       FontSize="9"
                                                       Foreground="#BFC9DB" />
                                            <TextBlock x:Name="LeftBatteryText"
                                                       Text="—"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="#1AFFFFFF"
                                            CornerRadius="12"
                                            Padding="10,7"
                                            Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="Right"
                                                       FontSize="9"
                                                       Foreground="#BFC9DB" />
                                            <TextBlock x:Name="RightBatteryText"
                                                       Text="—"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Background="#1AFFFFFF"
                                            CornerRadius="12"
                                            Padding="10,7"
                                            Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Case"
                                                       FontSize="9"
                                                       Foreground="#BFC9DB" />
                                            <TextBlock x:Name="CaseBatteryText"
                                                       Text="—"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Background="#12FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="2,0,2,11">
                                    <TextBlock Text="Noise Control"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="NoiseStatusText"
                                               Text="AAP ready"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                                <Border Background="#34000000"
                                        CornerRadius="14"
                                        Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="NoiseOffRadio"
                                                     Content="Off"
                                                     Tag="Off"
                                                     GroupName="Noise"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="1"
                                                     x:Name="NoiseAncRadio"
                                                     Content="ANC"
                                                     Tag="NoiseCancellation"
                                                     GroupName="Noise"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="2"
                                                     x:Name="NoiseTransparencyRadio"
                                                     Content="Transparency"
                                                     FontSize="10.5"
                                                     Padding="2,9"
                                                     Tag="Transparency"
                                                     GroupName="Noise"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="3"
                                                     x:Name="NoiseAdaptiveRadio"
                                                     Content="Adaptive"
                                                     Tag="Adaptive"
                                                     GroupName="Noise"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="NoiseModeRadio_OnChecked" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#12FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="2,0,2,11">
                                    <StackPanel>
                                        <TextBlock Text="Spatial Audio"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="SpatialStatusText"
                                                   Text="Checking the spatial engine…"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#1C7BA7FF"
                                            CornerRadius="8"
                                            Padding="7,4">
                                        <TextBlock x:Name="MotionBadge"
                                                   Text="HRTF"
                                                   FontSize="9"
                                                   Foreground="#BFD4FF" />
                                    </Border>
                                </Grid>
                                <Border Background="#34000000"
                                        CornerRadius="14"
                                        Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="SpatialOffRadio"
                                                     Content="Off"
                                                     Tag="Off"
                                                     GroupName="Spatial"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="SpatialModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="1"
                                                     x:Name="SpatialFixedRadio"
                                                     Content="Fixed"
                                                     Tag="Fixed"
                                                     GroupName="Spatial"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="SpatialModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="2"
                                                     x:Name="SpatialTrackedRadio"
                                                     Content="Head Tracked"
                                                     Tag="Tracked"
                                                     GroupName="Spatial"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="SpatialModeRadio_OnChecked"
                                                     ToolTip="SSAP3 HRTF + AirPods head tracking" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#12FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="15"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="11"
                                        Background="#1F758BFF">
                                    <TextBlock Text="♫"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Foreground="#C7D6FF" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="11,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Discord / games"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="AirPods Stereo + external microphone"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#183DE18D"
                                        CornerRadius="8"
                                        Padding="8,5"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="A2DP"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#75E7AB" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusLog"
                                           Text="SSAP3 is running in the tray"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DeviceAddress"
                                           Text="Waiting for AirPods"
                                           FontSize="9"
                                           Foreground="{StaticResource FaintTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="255" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Style="{StaticResource QuietButtonStyle}"
                                        Content="Report"
                                        Click="ReportButton_OnClick"
                                        ToolTip="Create a diagnostic ZIP"
                                        Margin="0,0,6,0" />
                                <Button x:Name="RepairButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Content="Repair"
                                        Click="RepairButton_OnClick"
                                        ToolTip="Restore the AirPods control profile"
                                        Margin="0,0,6,0" />
                                <Button Style="{StaticResource QuietButtonStyle}"
                                        Content="Exit"
                                        Click="ExitButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
