[SoundStage_Profile_Install.NT]
CopyFiles=DriverCopyFiles
AddReg=SoundStage_Device_AddReg

[SoundStage_Profile_Install.NT.Interfaces]
AddInterface={3E98D13A-B2A5-4C3D-AE1E-8DB4F3D8C1F0},,"SoundStage_Interface"

[SoundStage_Interface]
AddReg=SoundStage_Interface_AddReg

[SoundStage_Interface_AddReg]
HKR,,FriendlyName,,%ProfileDeviceName%

[SoundStage_Device_AddReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;BU)"
HKR,,DeviceCharacteristics,0x10001,0x00000100
HKR,,DeviceType,0x10001,0x00000022

[DriverCopyFiles]
soundstage-airpods4-anc.sys

[SoundStage_Profile_Install.NT.Services]
AddService=soundstage-airpods4-anc,0x00000002,SoundStage_Service_Install

[SoundStage_Service_Install]
DisplayName=%ServiceDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\soundstage-airpods4-anc.sys

[SoundStage_Profile_Install.NT.Wdf]
KmdfService=soundstage-airpods4-anc,SoundStage_Wdf_Section

[SoundStage_Wdf_Section]
KmdfLibraryVersion=1.31

[Strings]
ProviderName="SoundStage"
ProfileDeviceName="SoundStage Apple Control Profile"
ServiceDisplayName="SoundStage Apple Control Profile"
DiskName="SoundStage Driver Package"
