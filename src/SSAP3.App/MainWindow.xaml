<Window x:Class="SSAP3.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSAP3 Control Center"
        Width="430"
        Height="760"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F21A1D27" Offset="0" />
            <GradientStop Color="#F5151720" Offset="0.52" />
            <GradientStop Color="#F410121A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#55437BFF" Offset="0" />
            <GradientStop Color="#3A3D5BD9" Offset="0.48" />
            <GradientStop Color="#305CD6F6" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="PopupRoot" RenderTransformOrigin="0.95,0.98" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopupScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="PopupTranslate" Y="18" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border Margin="13" CornerRadius="30" Background="#80000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.52" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Margin="8"
                Background="{StaticResource WindowSurface}"
                BorderBrush="#3DFFFFFF"
                BorderThickness="1"
                CornerRadius="28"
                MouseLeftButtonDown="WindowSurface_OnMouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Ellipse Width="360" Height="280" Margin="-170,-160,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#264E84FF">
                    <Ellipse.Effect>
                        <BlurEffect Radius="55" />
                    </Ellipse.Effect>
                </Ellipse>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="20,16,20,20">
                        <!-- Header -->
                        <Grid Margin="3,0,3,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="28" Height="28" Source="/Assets/ssap3-mark.png" Stretch="Uniform" />
                                <StackPanel Margin="9,0,0,0">
                                    <TextBlock Text="SSAP3" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Control Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource CircleButtonStyle}" Content="⚙" FontSize="14" Click="SettingsButton_OnClick"
                                        Margin="0,0,7,0" ToolTip="Settings, calibration and diagnostics" AutomationProperties.Name="Settings" />
                                <Button Style="{StaticResource CircleButtonStyle}" Content="×" FontSize="18" Click="HideButton_OnClick"
                                        ToolTip="Hide to tray" AutomationProperties.Name="Hide" />
                            </StackPanel>
                        </Grid>

                        <!-- Device -->
                        <Border Background="{StaticResource HeroSurface}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="22" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="DeviceModel" Text="AirPods Pro 3" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="Gold" Margin="0,0,6,0" />
                                    <TextBlock x:Name="ConnectionTitle" Text="Looking for AirPods…" Foreground="#DDE8F7" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="ConnectionDetail" Text="" Foreground="#BFC9DB" FontSize="10" TextWrapping="Wrap" Margin="13,2,0,0" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1AFFFFFF" CornerRadius="12" Padding="10,7" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Left" FontSize="9" Foreground="#BFC9DB" />
                                            <TextBlock x:Name="LeftBatteryText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="12" Padding="10,7" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="Right" FontSize="9" Foreground="#BFC9DB" />
                                            <TextBlock x:Name="RightBatteryText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="12" Padding="10,7" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Case" FontSize="9" Foreground="#BFC9DB" />
                                            <TextBlock x:Name="CaseBatteryText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="BatterySourceText" Text="Battery unavailable" FontSize="9" Foreground="#A9B4C8" Margin="2,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Listening mode -->
                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="20" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="2,0,2,11">
                                    <TextBlock Text="Listening mode" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NoiseStatusText" Text="Unavailable" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <Border Background="#34000000" CornerRadius="14" Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="NoiseOffRadio" Content="Off" Tag="Off" GroupName="Noise" Style="{StaticResource SegmentStyle}" Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="1" x:Name="NoiseAncRadio" Content="ANC" Tag="NoiseCancellation" GroupName="Noise" Style="{StaticResource SegmentStyle}" Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="2" x:Name="NoiseTransparencyRadio" Content="Transparency" FontSize="10.5" Padding="2,9" Tag="Transparency" GroupName="Noise" Style="{StaticResource SegmentStyle}" Checked="NoiseModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="3" x:Name="NoiseAdaptiveRadio" Content="Adaptive" Tag="Adaptive" GroupName="Noise" Style="{StaticResource SegmentStyle}" Checked="NoiseModeRadio_OnChecked" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Spatial soundstage -->
                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="20" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="2,0,2,11">
                                    <StackPanel>
                                        <TextBlock Text="3D soundstage" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SpatialStatusText" Text="Checking the spatial engine…" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,2,70,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C7BA7FF" CornerRadius="8" Padding="7,4">
                                        <TextBlock x:Name="MotionBadge" Text="OFF" FontSize="9" Foreground="#BFD4FF" />
                                    </Border>
                                </Grid>
                                <Border Background="#34000000" CornerRadius="14" Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="SpatialOffRadio" Content="Off" Tag="Off" GroupName="Spatial" Style="{StaticResource SegmentStyle}" Checked="SpatialModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="1" x:Name="SpatialFixedRadio" Content="Fixed" Tag="Fixed" GroupName="Spatial" Style="{StaticResource SegmentStyle}" Checked="SpatialModeRadio_OnChecked" />
                                        <RadioButton Grid.Column="2" x:Name="SpatialTrackedRadio" Content="Head tracked" Tag="Tracked" GroupName="Spatial" Style="{StaticResource SegmentStyle}" Checked="SpatialModeRadio_OnChecked" />
                                    </Grid>
                                </Border>

                                <!-- Top-down view drawn from the real estimator pose. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="150" Height="120" Background="#22000000" CornerRadius="14" ToolTip="Top-down view: monitor, virtual speakers and your head (live data only)">
                                        <Canvas x:Name="StageCanvas" Width="150" Height="120">
                                            <Rectangle Canvas.Left="45" Canvas.Top="10" Width="60" Height="5" RadiusX="2" RadiusY="2" Fill="#8FA3C8" />
                                            <Ellipse x:Name="LeftSpeakerDot" Width="12" Height="12" Fill="#5CD6F6" />
                                            <Ellipse x:Name="RightSpeakerDot" Width="12" Height="12" Fill="#5CD6F6" />
                                            <Ellipse Canvas.Left="63" Canvas.Top="78" Width="24" Height="24" Fill="#F6F9FF" />
                                            <Line x:Name="NoseLine" X1="75" Y1="90" X2="75" Y2="66" Stroke="#F6F9FF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PoseText" Text="Yaw —   Pitch —" FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock x:Name="MotionDetailText" Text="Head tracking off" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8" />
                                        <Button x:Name="RecenterButton" Style="{StaticResource QuietButtonStyle}" Content="Recenter" Click="RecenterButton_OnClick"
                                                ToolTip="Face your monitor, then select Recenter" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Conversation -->
                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="20" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                                    <TextBlock Text="Conversation switching" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConversationStatusText" Text="Switches to Transparency while you talk (SSAP3 feature, processed locally)."
                                               FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <CheckBox x:Name="ConversationToggle" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                          Checked="ConversationToggle_OnChanged" Unchecked="ConversationToggle_OnChanged" AutomationProperties.Name="Conversation switching" />
                            </Grid>
                        </Border>

                        <!-- Footer -->
                        <Grid Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusLog" Text="SSAP3 is running in the tray" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource QuietButtonStyle}" Content="Report" Click="ReportButton_OnClick" ToolTip="Create a redacted, local diagnostic ZIP" Margin="0,0,6,0" />
                                <Button x:Name="ReconnectButton" Style="{StaticResource QuietButtonStyle}" Content="Reconnect" Click="ReconnectButton_OnClick" Margin="0,0,6,0" />
                                <Button Style="{StaticResource QuietButtonStyle}" Content="Exit" Click="ExitButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
