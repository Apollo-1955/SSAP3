<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\SoundStage.Core\SoundStage.Core.csproj" />
    <ProjectReference Include="..\SoundStage.Platform.Windows\SoundStage.Platform.Windows.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SoundStage</AssemblyName>
    <Version>0.3.0</Version>
    <FileVersion>0.3.0.0</FileVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <Product>SoundStage</Product>
    <Authors>OpenAI Codex</Authors>
    <Description>AirPods control center for Windows 10 and Windows 11</Description>
    <ApplicationIcon>..\..\assets\SoundStage.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\SoundStage.ico">
      <Link>Assets\SoundStage.ico</Link>
    </Resource>
    <Resource Include="..\..\assets\soundstage-mark.png">
      <Link>Assets\soundstage-mark.png</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\third_party\SoundVolumeView\SoundVolumeView.exe;..\..\third_party\SoundVolumeView\SoundVolumeView.chm;..\..\third_party\SoundVolumeView\readme.txt">
      <Link>tools\SoundVolumeView\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
