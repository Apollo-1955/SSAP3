[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ProviderName%
DriverVer=07/31/2026,0.4.0.0
CatalogFile=soundstage-airpods4-anc.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
soundstage-airpods4-anc.sys=1

[Manufacturer]
%ProviderName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
; Apple UARP service. Binding here gives the driver a stable fallback profile
; PDO on Bluetooth stacks that do not recreate the AAP PDO after reconnect.
