<Window x:Class="SSAP3.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSAP3 Settings"
        Width="640"
        Height="600"
        MinWidth="560"
        MinHeight="480"
        Background="#151720"
        Foreground="#F8FAFF"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CAD1DF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="14,9" Margin="0,2" CornerRadius="10" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#2A3150" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#A7B0C4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFF" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
        </Style>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="12">
        <TabItem Header="Soundstage">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Virtual speakers" Style="{StaticResource Heading}" />
                            <Canvas x:Name="RoomCanvas" Width="300" Height="200" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Rectangle x:Name="RoomOutline" Canvas.Left="10" Canvas.Top="5" Width="280" Height="190" RadiusX="14" RadiusY="14" Stroke="#40FFFFFF" StrokeDashArray="4 3" />
                                <Rectangle Canvas.Left="110" Canvas.Top="20" Width="80" Height="6" RadiusX="3" RadiusY="3" Fill="#8FA3C8" />
                                <TextBlock Canvas.Left="122" Canvas.Top="28" Text="monitor" FontSize="9" Foreground="#8FA3C8" />
                                <Ellipse x:Name="RoomLeftSpeaker" Width="16" Height="16" Fill="#5CD6F6" />
                                <Ellipse x:Name="RoomRightSpeaker" Width="16" Height="16" Fill="#5CD6F6" />
                                <Ellipse Canvas.Left="134" Canvas.Top="136" Width="32" Height="32" Fill="#F6F9FF" />
                                <Line x:Name="RoomNose" X1="150" Y1="152" X2="150" Y2="120" Stroke="#F6F9FF" StrokeThickness="4" StrokeEndLineCap="Round" />
                            </Canvas>
                            <TextBlock Text="Renderer" FontSize="12" />
                            <RadioButton x:Name="RendererMeasuredRadio" GroupName="Renderer" Foreground="#F8FAFF" Margin="0,3"
                                         Content="Measured: dummy-head HRTFs (MIT KEMAR), timbre-corrected" Click="Renderer_OnChanged" />
                            <RadioButton x:Name="RendererClassicRadio" GroupName="Renderer" Foreground="#F8FAFF" Margin="0,3,0,10"
                                         Content="Classic: the earlier model (time and level differences, head shadow)" Click="Renderer_OnChanged" />
                            <TextBlock x:Name="AzimuthLabel" Text="Speaker angle" FontSize="12" />
                            <Slider x:Name="AzimuthSlider" Minimum="10" Maximum="90" ValueChanged="StageSlider_OnValueChanged" />
                            <TextBlock x:Name="DistanceLabel" Text="Distance" FontSize="12" />
                            <Slider x:Name="DistanceSlider" Minimum="0.3" Maximum="5" ValueChanged="StageSlider_OnValueChanged" />
                            <TextBlock x:Name="ElevationLabel" Text="Height" FontSize="12" />
                            <Slider x:Name="ElevationSlider" Minimum="-30" Maximum="30" ValueChanged="StageSlider_OnValueChanged" />
                            <TextBlock x:Name="RoomLabel" Text="Room reflections" FontSize="12" />
                            <Slider x:Name="RoomSlider" Minimum="0" Maximum="1" ValueChanged="StageSlider_OnValueChanged" />
                            <TextBlock x:Name="IntensityLabel" Text="Spatial intensity" FontSize="12" />
                            <Slider x:Name="IntensitySlider" Minimum="0" Maximum="1" ValueChanged="StageSlider_OnValueChanged" />
                            <Button Content="Restore defaults" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Click="RestoreStage_OnClick" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Measured uses head-related responses from a generic dummy head (MIT KEMAR), interpolated for every head direction and equalised so the stage sounds tonally neutral. Classic is the earlier model. Both add a compact treated room, and switching between them is seamless, so compare them while listening. Neither is personalised: they do not give Apple's Personalized Spatial Audio or use an ear scan." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Head tracking">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live orientation" Style="{StaticResource Heading}" />
                            <TextBlock x:Name="LivePoseText" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                            <TextBlock x:Name="LiveMotionText" Text="—" Style="{StaticResource Note}" Margin="0,6,0,10" />
                            <Button Content="Recenter on monitor" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Click="Recenter_OnClick" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Motion source" Style="{StaticResource Heading}" />
                            <RadioButton x:Name="SourceSensorsRadio" GroupName="MotionSource" Foreground="#F8FAFF" Margin="0,3"
                                         Content="AirPods motion sensors (needs the Microsoft-signed SSAP3 driver)" Click="MotionSource_OnChanged" />
                            <RadioButton x:Name="SourceCompanionRadio" GroupName="MotionSource" Foreground="#F8FAFF" Margin="0,3"
                                         Content="Companion device that reads the AirPods (iPhone, iPad, Mac or Linux bridge)" Click="MotionSource_OnChanged" />
                            <RadioButton x:Name="SourceSimulatedRadio" GroupName="MotionSource" Foreground="#FFC86B" Margin="0,3"
                                         Content="Simulated motion (development only, NOT real head tracking)" Click="MotionSource_OnChanged" />
                            <StackPanel x:Name="CompanionPanel" Margin="22,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Address" FontSize="12" VerticalAlignment="Center" Width="60" />
                                    <TextBox x:Name="CompanionHostBox" Width="200" MaxLength="253" />
                                    <TextBlock Text="Port" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBox x:Name="CompanionPortBox" Width="60" MaxLength="5" />
                                    <Button Content="Apply" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" Click="CompanionApply_OnClick" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Create pairing code" Style="{StaticResource QuietButtonStyle}" Click="CreatePairing_OnClick" />
                                    <Button Content="Unpair" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" Click="Unpair_OnClick" />
                                </StackPanel>
                                <TextBox x:Name="PairingCodeBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="PairingStatusText" Style="{StaticResource Note}" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                       Text="Windows does not let normal apps open the AirPods' motion channel (checked on this PC: user-mode L2CAP refused, the AAP node cannot be opened, no LE, HID or sensor exposure). The AirPods option needs SSAP3's kernel driver, which Windows loads only once Microsoft has signed it. A companion that can read the AirPods sends orientation over an encrypted, paired connection to this PC; SSAP3 connects out to it and only on your local network." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pitch and roll" Style="{StaticResource Heading}" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                       Text="Yaw works straight away. For pitch and roll, face your screen, press Calibrate, then look UP first and nod three or four times within four seconds. The result is saved for this fit of the AirPods." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CalibrateButton" Content="Calibrate pitch and roll" Style="{StaticResource QuietButtonStyle}" Click="Calibrate_OnClick" />
                                <Button Content="Forget calibration" Style="{StaticResource QuietButtonStyle}" Margin="8,0,0,0" Click="ForgetCalibration_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="CalibrationStatusText" Style="{StaticResource Note}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Calibration" Style="{StaticResource Heading}" />
                            <CheckBox x:Name="HeadTrackingCheck" Content="Use AirPods head tracking in Head tracked mode" Click="Calibration_OnChanged" />
                            <CheckBox x:Name="DriftCheck" Content="Drift correction (slowly re-centres small, steady offsets)" Click="Calibration_OnChanged" />
                            <CheckBox x:Name="InvertYawCheck" Content="Invert yaw (turning left moves the stage the wrong way)" Click="Calibration_OnChanged" />
                            <CheckBox x:Name="InvertPitchCheck" Content="Invert pitch" Click="Calibration_OnChanged" />
                            <TextBlock x:Name="DecoderText" Style="{StaticResource Note}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Conversation">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conversation switching" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                                   Text="While the AirPods are in ANC or Adaptive and you start talking, SSAP3 requests Transparency. After you stop, it waits for the silence timeout and restores the previous mode. Changing the mode yourself pauses it for 10 minutes. This is SSAP3's own feature, not Apple's Conversation Awareness. Audio is never recorded or sent anywhere." />
                        <TextBlock x:Name="SilenceLabel" Text="Silence before restoring" FontSize="12" />
                        <Slider x:Name="SilenceSlider" Minimum="2" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SilenceSlider_OnValueChanged" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="Speech source: the AirPods' own speaking-level notifications (needs the AAP driver). A local computer-microphone detector exists in SSAP3.Core and is not yet wired to a microphone." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

        <TabItem Header="Diagnostics">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live status" Style="{StaticResource Heading}" />
                            <TextBlock x:Name="DiagnosticsText" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create redacted report" Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0" Click="Report_OnClick" />
                        <Button Content="Open log folder" Style="{StaticResource QuietButtonStyle}" Click="OpenLogs_OnClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Image Source="/Assets/ssap3-mark.png" Width="40" Height="40" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SSAP3 for Windows" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Note}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                       Text="Spatial Sound for AirPods Pro 3. Free software under GPL-3.0-or-later, derived from SoundStage for AirPods and built on LibrePods protocol research. See THIRD_PARTY.md." />
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                       Text="Security: SSAP3 never asks you to disable Secure Boot, Memory Integrity, Defender or driver signature enforcement, and never installs trust certificates." />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Privacy: no account, cloud or telemetry. Audio and Bluetooth identifiers stay on this PC. The only network use is the optional companion connection, which SSAP3 opens to a paired device on your local network and encrypts. AirPods and Apple are trademarks of Apple Inc.; SSAP3 is not affiliated with Apple." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
